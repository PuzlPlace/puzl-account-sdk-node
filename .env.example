# Puzl Account — lido por PzAccountSdkClientFactory.fromEnv() (process.env).
# Credenciais vazias de propósito: cada produto tem o seu client.
PUZL_ACCOUNT_ISSUER=
PUZL_ACCOUNT_CLIENT_ID=
PUZL_ACCOUNT_CLIENT_SECRET=
PUZL_ACCOUNT_REDIRECT_URI=
PUZL_ACCOUNT_SCOPE="openid email profile"
PUZL_ACCOUNT_TOKEN_AUTH_METHOD=client_secret_post
PUZL_ACCOUNT_TIMEOUT=10
PUZL_ACCOUNT_JWKS_CACHE_TTL=3600
PUZL_ACCOUNT_LEEWAY=60
